# ---- Server ----
PORT=3000

# Secret used to sign login tokens (JWT). Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Password for the auto-created "admin" account on first run.
DEFAULT_ADMIN_PASSWORD=admin123

# ---- Google Sheets (the database) ----
GOOGLE_SHEET_ID=your-google-sheet-id-here

# Local dev: path to the service-account JSON file.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# On a HOST (Render/Koyeb/etc): instead of the file above, paste the ENTIRE
# service-account JSON as one line into this variable. If set, it wins.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# ---- Behaviour ----
OFFLINE_AFTER_SECONDS=90

# 1 = run WITHOUT Google Sheets (in-memory, resets on restart). Use 0 in production.
MOCK_SHEETS=0
